{
  "name": "datia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "node ./scripts/seed.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:postgresql": "./scripts/migrate-to-postgresql.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prisma:gen:e2e": "prisma generate --schema prisma/schema.e2e.prisma",
    "db:reset:e2e": "E2E_SQLITE_URL=file:./playwright-e2e.db prisma migrate reset --schema prisma/schema.e2e.prisma --force",
    "test:e2e:sqlite": "E2E_SQLITE=1 DATABASE_URL=file:./playwright-e2e.db E2E_SQLITE_URL=file:./playwright-e2e.db E2E_SQLITE_RESET=0 ADMIN_E2E_EMAIL=admin@datia.icommunitylabs.com ADMIN_E2E_PASSWORD=admin123 playwright test --project=chromium",
    "test:e2e:sqlite:reset": "E2E_SQLITE=1 DATABASE_URL=file:./playwright-e2e.db E2E_SQLITE_URL=file:./playwright-e2e.db E2E_SQLITE_RESET=1 ADMIN_E2E_EMAIL=admin@datia.icommunitylabs.com ADMIN_E2E_PASSWORD=admin123 playwright test --project=chromium",
    "test:e2e:ux": "E2E_SQLITE=1 DATABASE_URL=file:./playwright-e2e.db E2E_SQLITE_URL=file:./playwright-e2e.db E2E_SQLITE_RESET=1 ADMIN_E2E_EMAIL=admin@datia.icommunitylabs.com ADMIN_E2E_PASSWORD=admin123 playwright test ux-journeys --project=chromium",
    "test:e2e:pg:nightly": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:json": "playwright test --reporter=json > playwright-report.json",
    "test:e2e:isolated": "node tests/e2e/run-isolated.mjs",
    "gen:e2e:schema": "node scripts/gen-e2e-schema.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.17.1",
    "@mantine/charts": "^7.17.8",
    "@mantine/core": "^7.17.8",
    "@mantine/dates": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@prisma/client": "^6.12.0",
    "@scalar/nextjs-api-reference": "^0.10.2",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "bcryptjs": "^3.0.2",
    "bootstrap-icons": "^1.13.1",
    "dayjs": "^1.11.23",
    "form-data": "^4.0.5",
    "jose": "^6.1.0",
    "leaflet": "^1.9.4",
    "mailgun.js": "^12.4.0",
    "next": "15.5.25",
    "next-intl": "^4.7.0",
    "postcss": "^8.5.19",
    "postcss-preset-mantine": "^1.18.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-toastify": "^11.0.5",
    "recharts": "^3.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.54.2",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "jsdom": "^26.1.0",
    "next-swagger-doc": "^0.4.1",
    "postcss-simple-vars": "^7.0.1",
    "prisma": "^6.12.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
